// Prisma 7: connection URL อยู่ใน prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  // เก็บเป็นตัวพิมพ์เล็กเสมอ (normalize ใน service) เพื่อไม่ให้สมัครซ้ำด้วยตัวพิมพ์ต่างกัน
  email        String     @unique
  passwordHash String
  displayName  String
  // ชื่อในลิงก์โปรไฟล์ (/u/username) เก็บตัวพิมพ์เล็ก บัญชีใหม่ได้ชื่อสุ่มจาก DB ก่อน แล้วค่อยเปลี่ยนเองทีหลัง
  username     String     @unique @default(dbgenerated("('user_'::text || substr(md5((random())::text), 1, 8))"))
  avatarKey    String?
  bio          String?
  location     String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions              Session[]
  listings              Listing[]            @relation("ListingSeller")
  reviewedListings      Listing[]            @relation("ListingReviewer")
  offers                Offer[]
  auditActions          AuditLog[]           @relation("AuditActor")
  auditTargets          AuditLog[]           @relation("AuditTarget")
  events                EventLog[]
  supportTickets        SupportTicket[]      @relation("TicketOwner")
  assignedTickets       SupportTicket[]      @relation("TicketAssignee")
  supportMessages       SupportMessage[]
  resetTokens           PasswordResetToken[]
  reviewsGiven          Review[]             @relation("ReviewAuthor")
  reviewsReceived       Review[]             @relation("ReviewSubject")
  reviewsRemoved        Review[]             @relation("ReviewRemover")
  conversationsAsBuyer  Conversation[]       @relation("ConversationBuyer")
  conversationsAsSeller Conversation[]       @relation("ConversationSeller")
  chatMessages          ChatMessage[]
  chatBlocksMade        ChatBlock[]          @relation("ChatBlocker")
  chatBlocksReceived    ChatBlock[]          @relation("ChatBlocked")
  escrowsAsBuyer        Escrow[]             @relation("EscrowBuyer")
  escrowsAsSeller       Escrow[]             @relation("EscrowSeller")
  escrowsDisputed       Escrow[]             @relation("EscrowDisputer")
  escrowsResolved       Escrow[]             @relation("EscrowResolver")
  escrowEvents          EscrowEvent[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  // เก็บแค่ sha256 ของ token ถ้า DB หลุดก็เอาไปใช้เป็น cookie ไม่ได้
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ListingType {
  SALE
  TRADE
  BOTH
}

enum ItemKind {
  SINGLE
  GRADED
  SEALED
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  CLOSED
}

// มาตรฐานสภาพการ์ดที่ใช้เหมือนกันทุกเกม เลยใช้ enum ได้
enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// เป็นตารางไม่ใช่ enum เพื่อให้ admin เพิ่มเกมใหม่ได้โดยไม่ต้อง migrate
model Game {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  // รูปบน tile หน้าแรก เก็บแค่ key เหมือนรูปอื่น ไฟล์จริงอยู่ใน storage ยังไม่มีรูปก็ใช้สีตาม slug แทน
  imageKey  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
}

model GradingCompany {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
}

// ฟิลด์เฉพาะแต่ละ itemKind เป็น nullable ส่วนเงื่อนไขว่าแบบไหนต้องมีอะไรบังคับด้วย zod ใน service
model Listing {
  id       String        @id @default(uuid()) @db.Uuid
  sellerId String        @db.Uuid
  seller   User          @relation("ListingSeller", fields: [sellerId], references: [id])
  gameId   String        @db.Uuid
  game     Game          @relation(fields: [gameId], references: [id])
  type     ListingType
  itemKind ItemKind
  status   ListingStatus @default(PENDING_REVIEW)

  title      String
  setName    String
  language   String
  cardNumber String?
  rarity     String?

  condition CardCondition?

  gradingCompanyId String?         @db.Uuid
  gradingCompany   GradingCompany? @relation(fields: [gradingCompanyId], references: [id])
  // Decimal เพราะ BGS/CGC มีเกรดครึ่ง เช่น 9.5
  grade            Decimal?        @db.Decimal(3, 1)
  certNumber       String?

  quantity    Int      @default(1)
  // null ได้เมื่อเป็น TRADE อย่างเดียว
  price       Decimal? @db.Decimal(12, 2)
  description String?

  rejectReason String?
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("ListingReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers        Offer[]
  offeredIn     OfferItem[]
  images        ListingImage[]
  conversations Conversation[]

  @@index([status, gameId])
  @@index([sellerId])
  // ให้ admin ค้นเลขเซอร์ซ้ำตอนตรวจประกาศได้เร็ว (ไม่ทำ unique เพราะการ์ดใบเดิมลงขายใหม่ได้หลังปิดประกาศ)
  @@index([gradingCompanyId, certNumber])
}

model Offer {
  id          String      @id @default(uuid()) @db.Uuid
  listingId   String      @db.Uuid
  listing     Listing     @relation(fields: [listingId], references: [id])
  buyerId     String      @db.Uuid
  buyer       User        @relation(fields: [buyerId], references: [id])
  // จำนวนที่ขอจากประกาศปลายทาง
  quantity    Int         @default(1)
  cashAmount  Decimal?    @db.Decimal(12, 2)
  message     String?
  status      OfferStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items   OfferItem[]
  reviews Review[]
  escrow  Escrow?

  @@index([listingId, status])
  @@index([buyerId])
}

model OfferItem {
  id        String  @id @default(uuid()) @db.Uuid
  offerId   String  @db.Uuid
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // ประกาศของผู้ขอที่เอามาแลก
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id])
  quantity  Int     @default(1)

  @@unique([offerId, listingId])
  @@index([listingId])
}

enum AuditAction {
  USER_PROMOTED
  USER_DEMOTED
  USER_SUSPENDED
  USER_REACTIVATED
  REVIEW_REMOVED
  LISTING_APPROVED
  LISTING_REJECTED
  CATALOG_CHANGED
  TICKET_CLOSED
  ESCROW_RELEASED
  ESCROW_REFUNDED
}

// บันทึกว่า admin คนไหนทำอะไรกับใคร ไว้ตรวจย้อนหลังเมื่อมีการใช้สิทธิ์ผิด
// ไม่มี API แก้หรือลบ log เพื่อให้ admin ลบร่องรอยตัวเองไม่ได้
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorId      String      @db.Uuid
  actor        User        @relation("AuditActor", fields: [actorId], references: [id])
  action       AuditAction
  // null เมื่อการกระทำไม่ได้เจาะจงผู้ใช้คนเดียว เช่น แก้ข้อมูลเกม รายละเอียดอยู่ใน detail
  targetUserId String?     @db.Uuid
  // ระบุ Restrict เอง เพราะ relation แบบ null ได้จะเป็น SetNull โดยปริยาย ซึ่งทำให้ประวัติเสียว่าใครถูกกระทำ
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  // เหตุผลที่ admin กรอก (เช่นตอนซ่อนรีวิว) หรือสิ่งที่ถูกแก้ ไว้ตรวจย้อนหลังว่าใช้สิทธิ์สมเหตุสมผลไหม
  detail       String?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@index([action, createdAt])
}

enum EventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REGISTER
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  RATE_LIMITED
  ACCESS_DENIED
  SERVER_ERROR
}

// log เหตุการณ์ด้านความปลอดภัยและ error ลบอัตโนมัติเมื่อเกิน LOG_RETENTION_DAYS (ต่างจาก AuditLog ที่เก็บถาวร)
// ห้ามเก็บรหัสผ่าน, token หรือ body ของ request
model EventLog {
  id         String    @id @default(uuid()) @db.Uuid
  type       EventType
  // ไม่ใช้ FK แบบ Restrict เพราะ log นี้ไม่ควรกันการลบผู้ใช้
  userId     String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // อีเมลที่ใช้ลองล็อกอิน เก็บเฉพาะ LOGIN_FAILED ไว้ดูว่ามีคนเดารหัสบัญชีไหน
  email      String?
  ip         String?
  userAgent  String?
  method     String?
  path       String?
  statusCode Int?
  // รหัสสั้น ๆ เช่น error code ห้ามใส่ข้อความ error เต็มเพราะอาจมีข้อมูลจาก query ติดมา
  detail     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

enum TicketCategory {
  ACCOUNT
  LISTING
  OFFER
  BUG
  OTHER
}

// OPEN = รอทีมงาน, ANSWERED = ทีมงานตอบแล้วรอผู้ใช้, CLOSED = ปิดแล้วตอบต่อไม่ได้
enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation("TicketOwner", fields: [userId], references: [id])
  subject    String
  category   TicketCategory
  status     TicketStatus   @default(OPEN)
  // admin ที่รับเรื่อง กันสองคนตอบเรื่องเดียวกันซ้ำ
  assigneeId String?        @db.Uuid
  assignee   User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  closedAt   DateTime?
  createdAt  DateTime       @default(now())
  // ขยับทุกครั้งที่มีข้อความใหม่ ใช้เรียงคิวในหลังบ้าน
  updatedAt  DateTime       @updatedAt

  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

// แก้หรือลบไม่ได้ เก็บไว้เป็นหลักฐานการติดต่อ
model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String        @db.Uuid
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  // บันทึกตอนเขียน ถ้า role ของผู้เขียนเปลี่ยนภายหลัง ข้อความเก่ายังแสดงถูกฝั่ง
  fromStaff Boolean
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// รูปที่ผู้ขายอัปโหลด ไฟล์จริงอยู่ใน storage (lib/storage.ts) ในตารางเก็บแค่ key ไว้หาไฟล์
model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key       String   @unique
  width     Int
  height    Int
  // ลำดับการแสดง รูปแรก (ค่าน้อยสุด) เป็นปก
  position  Int
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

// ลิงก์รีเซ็ตรหัสผ่านที่ส่งทางอีเมล เก็บแค่ sha256 ของ token เหมือน Session ถ้า DB หลุดก็เอาไปใช้ไม่ได้
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // ใช้ได้ครั้งเดียว ตั้งค่าตอนรีเซ็ตสำเร็จ
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// คะแนนที่คู่ดีลให้กันหลังตอบรับข้อเสนอ หนึ่งคนให้ได้หนึ่งรีวิวต่อดีล แก้ได้ภายใน 30 วันหลังตอบรับ (ตรวจใน service)
model Review {
  id           String    @id @default(uuid()) @db.Uuid
  offerId      String    @db.Uuid
  offer        Offer     @relation(fields: [offerId], references: [id])
  reviewerId   String    @db.Uuid
  reviewer     User      @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  revieweeId   String    @db.Uuid
  reviewee     User      @relation("ReviewSubject", fields: [revieweeId], references: [id])
  // 1-5 ดาว ตรวจช่วงค่าด้วย zod
  rating       Int
  comment      String?
  // admin ซ่อนรีวิวที่ไม่เหมาะสม ไม่ลบแถวจริงเพื่อเก็บเป็นหลักฐาน และกันคนเขียนสร้างรีวิวใหม่ในดีลเดิม
  removedAt    DateTime?
  removedById  String?   @db.Uuid
  removedBy    User?     @relation("ReviewRemover", fields: [removedById], references: [id])
  removeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([offerId, reviewerId])
  // หน้าโปรไฟล์ดึงรีวิวที่คนนี้ได้รับเรียงล่าสุดก่อน และคิดค่าเฉลี่ย
  @@index([revieweeId, createdAt])
}

// ห้องแชทหนึ่งห้องต่อหนึ่งประกาศต่อผู้ซื้อหนึ่งคน ทุกห้องมีการ์ดเป็นบริบท และข้อเสนอของคู่เดียวกันในประกาศนี้ใช้ห้องเดียวกัน
model Conversation {
  id               String    @id @default(uuid()) @db.Uuid
  listingId        String    @db.Uuid
  listing          Listing   @relation(fields: [listingId], references: [id])
  buyerId          String    @db.Uuid
  buyer            User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  // เก็บซ้ำจาก listing เพื่อให้ query กล่องข้อความใช้ index ได้ เจ้าของประกาศไม่มีทางเปลี่ยน
  sellerId         String    @db.Uuid
  seller           User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  // null = เปิดห้องแล้วยังไม่มีใครพิมพ์ ไม่แสดงในกล่องข้อความ
  lastMessageAt    DateTime?
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())

  messages ChatMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

// แก้หรือลบไม่ได้ เก็บไว้เป็นหลักฐานเวลามีข้อพิพาท มีข้อความหรือรูปอย่างใดอย่างหนึ่ง (ตรวจใน service)
model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  authorId       String       @db.Uuid
  author         User         @relation(fields: [authorId], references: [id])
  body           String?
  // รูปอยู่ใน storage ส่วนตัว ไม่ผ่าน /uploads และ key ไม่ส่งให้ client
  imageKey       String?      @unique
  imageWidth     Int?
  imageHeight    Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// บล็อกแล้วส่งข้อความหากันไม่ได้ทุกห้อง ไม่ว่าใครเป็นคนบล็อก ดีลที่ค้างยังดำเนินต่อได้
model ChatBlock {
  blockerId String   @db.Uuid
  blocker   User     @relation("ChatBlocker", fields: [blockerId], references: [id])
  blockedId String   @db.Uuid
  blocked   User     @relation("ChatBlocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// AWAITING_PAYMENT -> HELD -> SHIPPED -> RELEASED เป็นเส้นปกติ
// HELD/SHIPPED เปิดข้อพิพาทเป็น DISPUTED ได้ แล้ว admin ตัดสินเป็น RELEASED หรือ REFUNDED
enum EscrowStatus {
  AWAITING_PAYMENT
  HELD
  SHIPPED
  DISPUTED
  RELEASED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum EscrowEventType {
  CREATED
  PAID
  SHIPPED
  RECEIVED
  DISPUTED
  RELEASED
  REFUNDED
  CANCELLED
  EXPIRED
}

// เงินวางกลางของดีลที่มีเงินสด หนึ่ง offer มีได้หนึ่งแถว ตอนนี้เงินเป็น mock (ดู lib/payments.ts) แต่สถานะและกำหนดเวลาใช้งานจริง
model Escrow {
  id       String       @id @default(uuid()) @db.Uuid
  offerId  String       @unique @db.Uuid
  offer    Offer        @relation(fields: [offerId], references: [id])
  buyerId  String       @db.Uuid
  buyer    User         @relation("EscrowBuyer", fields: [buyerId], references: [id])
  sellerId String       @db.Uuid
  seller   User         @relation("EscrowSeller", fields: [sellerId], references: [id])
  // ล็อกยอดตอนตอบรับ ไม่อ่านจาก offer ซ้ำ
  amount   Decimal      @db.Decimal(12, 2)
  // ดีลเงินบวกการ์ดแลก ทั้งสองฝ่ายต้องส่งของและยืนยันรับ ผู้ขายจะได้ไม่เสียการ์ดที่ตกลงแลกกัน
  twoWay   Boolean
  status   EscrowStatus @default(AWAITING_PAYMENT)

  paymentDueAt DateTime
  shipDueAt    DateTime?
  confirmDueAt DateTime?
  paidAt       DateTime?

  // เลขอ้างอิงจากผู้ให้บริการชำระเงิน ใช้กระทบยอด ไม่ส่งให้ผู้ใช้
  paymentRef String?
  payoutRef  String?
  refundRef  String?

  sellerCarrier        String?
  sellerTrackingNumber String?
  sellerShippedAt      DateTime?
  buyerCarrier         String?
  buyerTrackingNumber  String?
  buyerShippedAt       DateTime?
  buyerReceivedAt      DateTime?
  sellerReceivedAt     DateTime?

  disputedAt    DateTime?
  disputedById  String?   @db.Uuid
  disputedBy    User?     @relation("EscrowDisputer", fields: [disputedById], references: [id], onDelete: Restrict)
  disputeReason String?

  settledAt      DateTime?
  // null เมื่อระบบปิดเองหรือคู่ดีลปิดกันเอง
  resolvedById   String?   @db.Uuid
  resolvedBy     User?     @relation("EscrowResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events EscrowEvent[]

  @@index([status, updatedAt])
  @@index([buyerId, status])
  @@index([sellerId, status])
}

// ประวัติทุกการเปลี่ยนแปลงของ escrow ไม่มี API แก้หรือลบ ใช้ตรวจย้อนหลังเมื่อมีข้อพิพาท
model EscrowEvent {
  id        String          @id @default(uuid()) @db.Uuid
  escrowId  String          @db.Uuid
  escrow    Escrow          @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  type      EscrowEventType
  // null = ระบบทำเองตามกำหนดเวลา
  actorId   String?         @db.Uuid
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  // สถานะหลังเหตุการณ์นี้
  status    EscrowStatus
  note      String?
  createdAt DateTime        @default(now())

  @@index([escrowId, createdAt])
}
