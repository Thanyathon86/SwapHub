# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (ห้าม commit .env)
NODE_ENV=development
PORT=4000
# ใช้ user แยกสำหรับแอป ไม่ใช้ superuser "postgres"
DATABASE_URL="postgresql://ge175_app:CHANGE_ME@localhost:5432/ge175?schema=public"
# ตอน NODE_ENV=production ทั้งสองค่าต้องเป็น https ไม่งั้นแอปจะไม่เริ่มทำงาน
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# จำนวน reverse proxy หน้าแอป (0 = ต่อตรง, เช่น 1 ถ้าอยู่หลัง nginx ตัวเดียว)
TRUST_PROXY=0
# อายุ session (วัน) นับจากใช้งานล่าสุด ต่ออายุอัตโนมัติแต่ไม่เกิน SESSION_ABSOLUTE_DAYS นับจาก login
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# session ของ admin (ชั่วโมง) ใช้หลักเดียวกันแต่สั้นกว่า เพราะบัญชี admin เข้าถึงข้อมูลของทุกคน
ADMIN_SESSION_TTL_HOURS=2
ADMIN_SESSION_ABSOLUTE_HOURS=12
# จำนวนวันที่เก็บ log เหตุการณ์ (ล็อกอิน, error ฯลฯ) ก่อนลบอัตโนมัติ ประวัติการจัดการของ admin เก็บถาวรไม่ถูกลบ
LOG_RETENTION_DAYS=60
# โฟลเดอร์เก็บรูปที่ผู้ขายอัปโหลด (อยู่ใน .gitignore) ถ้าย้ายไป S3/R2 ให้แก้ที่ src/lib/storage.ts
UPLOAD_DIR=uploads
# โฟลเดอร์ build ของหน้าเว็บ (รัน npm run build ที่ root ก่อน) ตั้งแล้ว Express เสิร์ฟหน้าเว็บเองพร้อม security header
# แยกแอปตาม hostname จึงต้องใช้คนละ hostname เช่น tcgnexus.example กับ admin.tcgnexus.example
# ตอน NODE_ENV=production ต้องตั้งเสมอ ไม่งั้นแอปจะไม่เริ่มทำงาน ส่วนตอน dev ไม่ต้องตั้ง เพราะ Vite เสิร์ฟหน้าเว็บให้
# WEB_CLIENT_DIR=../client/dist
# WEB_ADMIN_DIR=../admin/dist
# ส่งอีเมล (ลิงก์ลืมรหัสผ่าน) ถ้าไม่ตั้ง SMTP_URL ระบบจะพิมพ์อีเมลลง console ของ server แทน เหมาะกับตอน dev
# ตอน NODE_ENV=production ต้องตั้งเสมอ ไม่งั้นแอปจะไม่เริ่มทำงาน
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=TCGNexus <no-reply@tcgnexus.local>
# ใช้ตอน npm run db:seed เพื่อสร้าง admin คนแรก ลบออกจาก .env ได้หลัง seed
# รหัสต้องยาวอย่างน้อย 12 ตัวและเดาไม่ได้ seed จะไม่ยอมใช้รหัสตัวอย่างหรือยกบัญชีผู้ใช้ที่มีอยู่แล้วให้เป็น admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
